# Server Configuration
PORT=3000

# Database Configuration (Supabase)
# Get these values from your Supabase project:
# 1. Go to https://supabase.com/dashboard
# 2. Select your project → Settings → Database
# 3. Find connection string in "Connection string" section

DB_HOST=your-project.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.your-project-ref
DB_PASSWORD=your_supabase_password
DB_SSL=true

# Connection Pooler (recommended for better performance)
# Use this instead of DB_HOST for connection pooling:
# DB_HOST=your-project-pooler.supabase.co
# DB_PORT=6543

# Authentication Configuration
# Use a long, random string for JWT_SECRET (e.g., openssl rand -base64 32)
JWT_SECRET=your_jwt_secret_key_here
